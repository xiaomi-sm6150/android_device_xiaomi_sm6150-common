cc_library_shared {
    name: "libsdmextension",
    vendor: true,
    srcs: ["sdmextension.cpp"],
    header_libs: ["display_headers"],
    shared_libs: [
        "libdl",
        "liblog",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
    ],
}
